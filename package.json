{
	"name": "snapchat-for-woocommerce",
	"title": "Snapchat for WooCommerce",
	"description": "Snapchat for WooCommerce",
	"version": "1.0.5",
	"author": "The WordPress Contributors",
	"license": "GPL-3.0+",
	"keywords": [
		"WooCommerce",
		"Snapchat"
	],
	"repository": {
		"type": "git",
		"url": "git@github.com:woocommerce/snapchat-for-woocommerce.git"
	},
	"bugs": {
		"url": "https://github.com/woocommerce/snapchat-for-woocommerce/issues"
	},
	"config": {
		"wp_org_slug": "snapchat-for-woocommerce"
	},
	"dependencies": {
		"@woocommerce/components": "^14.1.0",
		"@woocommerce/navigation": "^9.0.0",
		"@woocommerce/tracks": "^1.5.1",
		"@wordpress/api-fetch": "^7.33.1",
		"@wordpress/base-styles": "^6.9.1",
		"@wordpress/components": "^30.6.5",
		"@wordpress/compose": "^7.33.1",
		"@wordpress/data": "^10.33.1",
		"@wordpress/element": "^6.33.1",
		"@wordpress/hooks": "^4.33.1",
		"@wordpress/i18n": "^6.6.1",
		"@wordpress/url": "^4.33.1",
		"classnames": "^2.5.1",
		"gridicons": "^3.4.2",
		"lodash": "^4.18.1"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@woocommerce/dependency-extraction-webpack-plugin": "^5.1.0",
		"@woocommerce/e2e-utils-playwright": "^0.5.1",
		"@woocommerce/eslint-plugin": "^4.0.0",
		"@wordpress/env": "^11.16.0",
		"@wordpress/prettier-config": "^4.56.0",
		"@wordpress/scripts": "^36.0.0",
		"eslint": "^10.0.0",
		"eslint-import-resolver-webpack": "^0.13.8",
		"mini-css-extract-plugin": "^2.9.0",
		"path-browserify": "^1.0.1",
		"prettier": "npm:wp-prettier@^3.0.3",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"stylelint-config-standard-scss": "^17.0.0",
		"typescript": "^5.5.4",
		"woocommerce-grow-jsdoc": "git+https://github.com/woocommerce/grow#jsdoc-v1"
	},
	"overrides": {
		"@woocommerce/dependency-extraction-webpack-plugin": {
			"@wordpress/dependency-extraction-webpack-plugin": "^6.56.0"
		},
		"react-router-dom": "^7.18.0",
		"d3-scale": "^4.0.2",
		"d3-scale-chromatic": "^3.0.0",
		"d3-color": "^3.1.0",
		"serialize-javascript": "^7.0.5",
		"colord": "^2.9.4",
		"qs": "^6.16.0",
		"@babel/runtime": "^7.26.10",
		"uuid@<11": "^11.1.1"
	},
	"scripts": {
		"prebuild": "composer install --no-dev",
		"build": "NODE_ENV=production wp-scripts build --webpack-src-dir=js/src",
		"postbuild": "npm run archive",
		"archive": "composer archive --file=$npm_package_name --format=zip",
		"postarchive": "rm -rf $npm_package_name && unzip $npm_package_name.zip -d $npm_package_name && rm $npm_package_name.zip && zip -r $npm_package_name.zip $npm_package_name && rm -rf $npm_package_name",
		"doc:tracking": "woocommerce-grow-jsdoc ./js/src",
		"format": "wp-scripts format",
		"i18n": "WP_CLI_PHP_ARGS='-d memory_limit=2048M' ./vendor/bin/wp i18n make-pot ./ languages/$npm_package_name.pot --slug=$npm_package_name --domain=$npm_package_name --exclude=bin,data,js/src,node_modules,tests,vendor",
		"lint": "npm run lint:php && npm run lint:js && npm run lint:css",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"lint:js:fix": "wp-scripts lint-js --fix",
		"lint:php": "vendor/bin/phpcs",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"env": "wp-env",
		"env:start": "wp-env start",
		"env:clean": "wp-env clean",
		"env:stop": "wp-env stop",
		"env:destroy": "wp-env destroy",
		"postenv:start": "bash ./tests/e2e/bin/initialize.sh",
		"test:e2e": "npx playwright test --config tests/e2e/playwright.config.js",
		"start": "wp-scripts start --webpack-src-dir=js/src"
	},
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
	"engines": {
		"node": "^24",
		"npm": "^11"
	}
}
